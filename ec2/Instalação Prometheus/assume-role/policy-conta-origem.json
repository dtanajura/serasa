{
  "Version": "2012-10-17",
  "Statement": [
    {
        "Effect": "Allow",
        "Action": [
          "sts:AssumeRole",
          "sts:AssumeRoleWithWebIdentity"
        ],
        "Resource": "*"
      },
      {
          "Action": [
              "ec2:DescribeInstances",
              "ec2:DescribeTags",
              "sts:GetCallerIdentity"
          ],
          "Resource": "*",
          "Effect": "Allow"
      }
    ]
}
