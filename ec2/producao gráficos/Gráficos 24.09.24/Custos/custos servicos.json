        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "adsnc9ymobl6oa"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "WITH ranked_costs AS (\r\n    SELECT\r\n        s.short_name as service,\r\n        TO_CHAR(rc.date_register, 'YYYY-MM') AS month,\r\n        SUM(rc.unblended_cost) AS total_cost,\r\n        DENSE_RANK() OVER (PARTITION BY TO_CHAR(rc.date_register, 'YYYY-MM') ORDER BY SUM(rc.unblended_cost) DESC) AS rank\r\n    FROM\r\n        resource_costs rc\r\n    JOIN\r\n        servicos s ON rc.service = s.service\r\n    GROUP BY\r\n        s.short_name,\r\n        TO_CHAR(rc.date_register, 'YYYY-MM')\r\n)\r\nSELECT\r\n    month,\r\n    service,\r\n    total_cost\r\nFROM\r\n    ranked_costs\r\nWHERE\r\n    rank <= 6\r\nORDER BY\r\n    month DESC,\r\n    rank\r\nLIMIT 18;\r\n",
            "refId": "A",
            "sql": {
              "columns": [
                {
                  "parameters": [],
                  "type": "function"
                }
              ],
              "groupBy": [
                {
                  "property": {
                    "type": "string"
                  },
                  "type": "groupBy"
                }
              ],
              "limit": 50
            }
          }
        ],
