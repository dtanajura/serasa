            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "WITH ranked_costs AS (\r\n    SELECT\r\n        tdc.tag_name AS short_tag_name,\r\n        TO_CHAR(tdc.date_register, 'YYYY-MM') AS month,\r\n        SUM(tdc.unblended_cost) AS total_cost,\r\n        DENSE_RANK() OVER (PARTITION BY TO_CHAR(tdc.date_register, 'YYYY-MM') ORDER BY SUM(tdc.unblended_cost) DESC) AS rank\r\n    FROM\r\n      tag_details_costs tdc\r\n    JOIN\r\n      accounts a ON tdc.account_id = a.account_id\r\n    WHERE \r\n      tdc.service IN (${var_servicos})\r\n      AND a.account_name IN ( $var_contas )\r\n    GROUP BY\r\n        tdc.tag_name,\r\n        TO_CHAR(tdc.date_register, 'YYYY-MM')\r\n)\r\nSELECT\r\n    month,\r\n    short_tag_name,\r\n    total_cost\r\nFROM\r\n    ranked_costs\r\nWHERE\r\n    rank <= 5\r\nORDER BY\r\n    month DESC,\r\n    rank\r\nLIMIT 15;\r\n",
            "refId": "A",
            "sql": {
              "columns": [
                {
                  "parameters": [],
                  "type": "function"
                }
              ],
              "groupBy": [
