{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDataSyncToWriteLogs",
      "Effect": "Allow",
      "Principal": {
        "Service": "datasync.amazonaws.com"
      },
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    }
  ]
}