{
	"Version": "2012-10-17",
	"Id": "S3-Console-Auto-Gen-Policy-1685467870940",
	"Statement": [
		{
			"Sid": "InventoryAndAnalyticsExamplePolicy",
			"Effect": "Allow",
			"Principal": {
				"Service": "s3.amazonaws.com"
			},
			"Action": "s3:PutObject",
			"Resource": "arn:aws:s3:::inventory-results-230530/*",
			"Condition": {
				"StringEquals": {
					"s3:x-amz-acl": "bucket-owner-full-control",
					"aws:SourceAccount": "492208500822"
				},
				"ArnLike": {
					"aws:SourceArn": "arn:aws:s3:::file-share-claranet"
				}
			}
		},
		{
			"Sid": "AllowBatchOperationsSourceObjectCOPY",
			"Effect": "Allow",
			"Principal": {
				"AWS": [
					"arn:aws:iam::328257591560:role/BURoleForDigitalBatchOperationsDestinationRoleCOPY",
					"arn:aws:sts::328257591560:assumed-role/BURoleForExperianBRCloudOps/C96531A@br.experian.local"
				]
			},
			"Action": [
				"s3:GetObject",
				"s3:GetObjectVersion",
				"s3:GetObjectAcl",
				"s3:GetObjectTagging",
				"s3:GetObjectVersionAcl",
				"s3:GetObjectVersionTagging"
			],
			"Resource": "arn:aws:s3:::inventory-results-230530/*"
		}
	]
}