{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor01",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:ListBucket",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::eec-aws-br-eits-datahub-plataforma-preview-prod-bucket",
        "arn:aws:s3:::eec-aws-br-eits-datahub-plataforma-preview-prod-bucket/*"
      ]
    },
    {
      "Sid": "VisualEditor02",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:sa-east-1:415071355886:function:experian-datahub-plataforma-knarr-prod"
    },
    {
      "Sid": "VisualEditor03",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::eec-aws-br-eits-datahub-*-silver-prod-bucket",
        "arn:aws:s3:::eec-aws-br-eits-datahub-*-silver-prod-bucket/*",
        "arn:aws:s3:::eec-aws-br-eits-datahub-*-*-prod-bucket",
        "arn:aws:s3:::eec-aws-br-eits-datahub-*-*-prod-bucket/*"
      ]
    },
    {
      "Sid": "VisualEditor04",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:sa-east-1:415071355886:eec-aws-br-eits-datahub-prod-plataforma-producer-activate-sqs"
    }
  ]
}