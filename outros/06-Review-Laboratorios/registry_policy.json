{
    "Version": "2008-10-17",
    "Statement": [
        {
            "Sid": "aws-public",
            "Effect": "Allow",
            "Principal": "*",
            "Action": [
                "ecr:CreateRepository",
                "ecr:BatchImportUpstreamImage"
            ],
            "Resource": "arn:aws:ecr:sa-east-1:380979651404:repository/aws-public/*",
            "Condition": {
                "StringLike": {
                    "aws:PrincipalArn": "arn:aws:iam::380979651404:role/BURoleForEksN*"
                }
            }
        }
    ]
}