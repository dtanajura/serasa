{
    "schemaVersion": "2.2",
    "description": "Coletar metricas de CPU, memoria e disco",
    "mainSteps": [
        {
            "action": "aws:runShellScript",
            "name": "obterMetricas",
            "inputs": {
                "runCommand": [
                    "echo 'Uso de CPU:'",
                    "top -bn1 | grep 'Cpu(s)' | awk '{print $2}' | sed 's/%//'",
                    "echo 'Uso de Memoria:'",
                    "free -m | awk 'NR==2{printf \"%.2f\", $3*100/$2 }'",
                    "echo 'Uso de Disco (/var):'",
                    "df -h /var | awk 'NR==2 {print $5}' | sed 's/%//'"
                ]
            }
        }
    ]
}