            "Effect": "Allow",
            "Resource": [
                "arn:aws:sns:sa-east-1:527623259369:eec-aws-br-eits-datahub-dev-mercantil-remessas"
            ]
        },
        {
            "Action": [
                "sqs:CreateQueue",
                "sqs:GetQueueUrl",
                "sqs:GetQueueAttributes",
                "sqs:SendMessage",
                "sqs:SendMessageBatch",
                "sqs:ReceiveMessage",
                "sqs:DeleteMessage",
                "sqs:DeleteMessageBatch"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:sqs:sa-east-1:527623259369:eec-aws-br-eits-datahub-uat-mercantil-processar-cadastral.fifo",
                "arn:aws:sqs:sa-east-1:527623259369:eec-aws-br-eits-datahub-uat-mercantil-processar-remessa.fifo"
            ]
        },
        {
            "Action": [
                "kms:Decrypt",
                "kms:GenerateDataKey"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:kms:sa-east-1:527623259369:key/*"
            ]
        },
        {
            "Action": [
                "iam:PassRole"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:iam::527623259369:role/*"
        },
        {
            "Action": [
                "ec2:Describe*"
            ],
            "Effect": "Allow",
            "Resource": "*"
        }
    ],
    "Version": "2012-10-17"
}