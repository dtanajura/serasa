                "arn:aws:s3:::eec-aws-br-eits-datahub-positivo-mercantil-raw-uat-bucket/*",
                "arn:aws:s3:::eec-aws-br-eits-datahub-positivo-mercantil-silver-uat-bucket/*"
            ]
        },
        {
            "Action": [
                "glue:GetDatabase",
                "glue:GetDatabases",
                "glue:GetTable",
                "glue:GetTables",
                "glue:GetPartition",
                "glue:GetPartitions",
                "glue:BatchGetPartition",
                "glue:CreateTable",
                "glue:UpdateTable",
                "glue:CreatePartition",
                "glue:BatchCreatePartition"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:glue:sa-east-1:527623259369:database/db_positivo_mercantil",
                "arn:aws:glue:sa-east-1:527623259369:catalog",
                "arn:aws:glue:sa-east-1:527623259369:table/db_positivo_mercantil/*",
                "arn:aws:glue:sa-east-1:294463638235:database/db_positivo_mercantil",
                "arn:aws:glue:sa-east-1:294463638235:catalog",
                "arn:aws:glue:sa-east-1:294463638235:table/db_positivo_mercantil/*"
            ]
        },
        {
            "Action": [
                "ssm:GetParameter"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:ssm:sa-east-1:527623259369:parameter/experian-datahub-positivo-mercantil-emr-conf"
            ]
        },
        {
            "Action": [
                "elasticmapreduce:ListClusters"
            ],
            "Effect": "Allow",
            "Resource": "*"
        },
        {
            "Action": [
                "elasticmapreduce:RunJobFlow",
                "elasticmapreduce:AddTags",
                "elasticmapreduce:AddJobFlowSteps",
                "elasticmapreduce:DescribeCluster",
                "elasticmapreduce:TerminateJobFlows",
                "elasticmapreduce:ListInstanceGroups"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:elasticmapreduce:sa-east-1:527623259369:cluster/*"
        },
        {
            "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:GetDownloadUrlForLayer",
                "ecr:GetRepositoryPolicy",
                "ecr:DescribeRepositories",
                "ecr:ListImages",
                "ecr:BatchGetImage",
                "ecr:InitiateLayerUpload",
                "ecr:UploadLayerPart",
                "ecr:CompleteLayerUpload",
                "ecr:PutImage"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:ecr:sa-east-1:527623259369:repository/experian-datahub-positivo-mercantil"
            ]
        },
        {
            "Action": "ecr:GetAuthorizationToken",
            "Effect": "Allow",
            "Resource": "*"
        },
        {
            "Action": [
                "ecr:GetDownloadUrlForLayer",
                "ecr:BatchGetImage",
                "ecr:BatchCheckLayerAvailability"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:ecr:sa-east-1:527623259369:repository/experian-datahub-studio"
            ]
        },
        {
            "Action": [
                "dynamodb:PutItem",
                "dynamodb:GetItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:Query",
                "dynamodb:Scan",
                "dynamodb:BatchGetItem",
                "dynamodb:BatchWriteItem",
                "dynamodb:DescribeTable"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:dynamodb:sa-east-1:527623259369:table/tb_positivo_mercantil_controle_remessa"
        },
        {
            "Action": [
                "secretsmanager:GetSecretValue"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:secretsmanager:sa-east-1:527623259369:secret:eec-aws-br-eits-datahub-dev-iam-credentials-observability*"
            ]
        },
        {
