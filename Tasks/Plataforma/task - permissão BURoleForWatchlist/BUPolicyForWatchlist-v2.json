{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor02",
      "Effect": "Allow",
      "Action": [
        "glue:*",
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecretVersionIds",
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:PurgeQueue",
        "sqs:ListQueues",
        "elasticmapreduce:ListClusters",
        "elasticmapreduce:AddJobFlowSteps",
        "elasticmapreduce:TerminateJobFlows",
        "elasticmapreduce:DescribeCluster",
        "elasticmapreduce:AddTags",
        "elasticmapreduce:DescribeStep"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::eec-aws-br-eits-datahub-watchlist-raw-dev-bucket/*",
        "arn:aws:s3:::eec-aws-br-eits-datahub-watchlist-raw-dev-bucket",
        "arn:aws:s3:::eec-aws-br-eits-datahub-watchlist-bronze-dev-bucket/*",
        "arn:aws:s3:::eec-aws-br-eits-datahub-watchlist-bronze-dev-bucket",
        "arn:aws:s3:::eec-aws-br-eits-datahub-watchlist-silver-dev-bucket/*",
        "arn:aws:s3:::eec-aws-br-eits-datahub-watchlist-silver-dev-bucket"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "elasticmapreduce:RunJobFlow",
      "Resource": "*"
    },
    {
      "Sid": "ECRLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ECRPull",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability",
        "ecr:DescribeImages",
        "ecr:ListImages",
        "ecr:DescribeRepositories",
        "ecr:GetRepositoryPolicy"
      ],
      "Resource": "arn:aws:ecr:sa-east-1:730335661246:repository/*"
    }
  ]
}